TRACEAI_DATABASE_URL=postgresql+psycopg://traceai:traceai@localhost:5434/traceai
TRACEAI_QDRANT_URL=http://localhost:6333
TRACEAI_QDRANT_REQUIREMENTS_COLLECTION=requirements_v2
TRACEAI_QDRANT_CODE_COLLECTION=code_units_v2
TRACEAI_VECTOR_SIZE=768
TRACEAI_API_BASE_URL=http://localhost:8100

# Embedding provider: local (default), huggingface, gemini, hash
TRACEAI_EMBEDDING_PROVIDER=local

# Local embedding model (default: BAAI/bge-base-en-v1.5, 768d)
# TRACEAI_LOCAL_MODEL=BAAI/bge-base-en-v1.5
TRACEAI_EMBEDDING_MODEL=gemini-embedding-001

# Gemini API key (used for reranking + optional embedding)
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace token (backup embedding provider)
HF_TOKEN=your_hf_token_here
